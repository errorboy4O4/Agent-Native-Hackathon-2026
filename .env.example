# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# DataPilot: Gemini key for summaries and Q&A (never commit a real value)
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: comma-separated model preference order
# DATAPILOT_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-3.1-flash-lite
